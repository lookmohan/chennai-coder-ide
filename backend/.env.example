ENV=development
# Format: mysql+pymysql://USER:PASSWORD@HOST:PORT/DATABASE?charset=utf8mb4
# Use letters/numbers only in the password. If it has special characters, URL-encode them.
DATABASE_URL=mysql+pymysql://chennai:CHANGE_ME@localhost:3306/chennai_coder?charset=utf8mb4
REDIS_URL=redis://localhost:6379/0

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"  (min 32 chars)
JWT_SECRET=
JWT_EXPIRES_MINUTES=60

CORS_ORIGINS=http://localhost:3000
COOKIE_SECURE=false
COOKIE_DOMAIN=

# Rate limits (fixed window)
RATE_LOGIN_PER_MINUTE=10
RATE_LOGIN_PER_EMAIL_PER_15MIN=10
RATE_REGISTER_PER_HOUR=10
SUBMISSION_RATE_PER_MINUTE=10

# Judging queue: thread = in-process (local dev, no Redis needed). celery = Redis worker (production).
QUEUE_MODE=thread

# Code runner (Judge0-compatible). Leave JUDGE0_URL empty until you have a runner.
# Submissions are refused with a clear message while it is empty.
JUDGE0_URL=
JUDGE0_API_KEY=
JUDGE0_TIMEOUT_SECONDS=15

# Used from Phase 6 onward
AI_MENTOR_DAILY_LIMIT=10
