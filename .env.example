# Chennai Coder - root environment for docker-compose.
# Copy to `.env` and fill in. NEVER commit the real .env file.

# --- MySQL (used by the compose `mysql` service) ---
# Use letters and numbers only in passwords (special characters break the database URL).
MYSQL_ROOT_PASSWORD=
MYSQL_USER=chennai
MYSQL_PASSWORD=
MYSQL_DATABASE=chennai_coder

# --- Backend ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRES_MINUTES=60
CORS_ORIGINS=http://localhost:3000
# Set to true when served over HTTPS (required in production)
COOKIE_SECURE=false
